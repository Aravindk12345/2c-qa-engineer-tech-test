{
  "name": "qa-engineer-tech-test",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:ui:e2e": "playwright test tests/ui/tests/book.e2e.spec.ts",
    "test:api:e2e": "playwright test tests/api/tests",
    "test:api:happy": "playwright test tests/api/tests/api.happy.spec.ts --project=chromium",
    "test:api:negative": "playwright test tests/api/tests/api.negative.spec.ts --project=chromium",
    "test:api:sanity": "playwright test tests/api/tests -g @sanity --project=chromium",
    "test:api:smoke": "playwright test tests/api/tests -g @smoke --project=chromium",
    "test:api:regression": "playwright test tests/api/tests -g @regression --project=chromium"
  },
  "dependencies": {
    "next": "15.5.2",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
